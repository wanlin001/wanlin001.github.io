#!/bin/bash
# Compress any oversized image that is about to be committed, then re-stage it.
# Enabled by:  git config core.hooksPath .githooks   (already done in this repo)
# Skip once with:  git commit --no-verify

set -u
root=$(git rev-parse --show-toplevel)

staged=$(git diff --cached --name-only --diff-filter=ACM -- 'images/*' \
         | grep -Ei '\.(jpg|jpeg|png)$' || true)
[ -z "$staged" ] && exit 0

paths=()
while IFS= read -r p; do [ -f "$root/$p" ] && paths+=("$root/$p"); done <<< "$staged"
[ ${#paths[@]} -eq 0 ] && exit 0

out=$("$root/scripts/optimize_images.sh" "${paths[@]}")
if [ -n "$out" ]; then
  echo "── 圖片自動壓縮 ───────────────────────────────"
  echo "$out"
  git add -- "${paths[@]}"
  echo "───────────────────────────────────────────────"
fi

heic=$(git diff --cached --name-only --diff-filter=ACM -- 'images/*' | grep -Ei '\.heic$' || true)
if [ -n "$heic" ]; then
  echo "⚠️  這些是 HEIC，網頁瀏覽器不一定支援，建議先轉成 JPG："
  echo "$heic" | sed 's/^/     /'
  echo "     sips -s format jpeg -s formatOptions 55 檔名.heic --out 檔名.jpg"
fi
exit 0
